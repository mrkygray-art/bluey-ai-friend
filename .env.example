# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional overrides (the code has defaults)
BLUEY_MODEL=
BLUEY_SPEECH_MODEL=
BLUEY_SPEECH_VOICE=
BLUEY_TRANSCRIBE_MODEL=
# Bluey recognizes his creator only when this account is signed in (Vercel secret)
BLUEY_CREATOR_EMAIL=
# Brain Lab only, on vercel dev: lets the creator-verified case pass without signing in
BLUEY_CREATOR_CODE=
