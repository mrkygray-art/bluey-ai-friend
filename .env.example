# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional overrides (the code has defaults)
BLUEY_MODEL=
BLUEY_SPEECH_MODEL=
BLUEY_SPEECH_VOICE=
BLUEY_TRANSCRIBE_MODEL=
# Making pictures (api/media/*). Model names: check developers.openai.com before changing.
# Server-only Supabase secret key: media rows and files are written only by the server.
SUPABASE_SECRET_KEY=
MEDIA_IMAGE_MODEL=gpt-image-2.5-flare
MEDIA_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
MEDIA_IMAGE_QUALITY=medium
MEDIA_DAILY_LIMIT_IMAGE=10
MEDIA_DAILY_LIMIT_VIDEO=2
# Optional: the model for the quick "no real people" check (defaults to BLUEY_MODEL)
MEDIA_CHECK_MODEL=
